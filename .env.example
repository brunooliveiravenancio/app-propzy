# Servidor
PORT=3000
BASE_URL=https://your-ngrok-url.ngrok.io

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+351xxxxxxxxx

# Deepgram (STT - PT-PT)
DEEPGRAM_API_KEY=your_deepgram_api_key

# DeepSeek (LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key

# ElevenLabs (TTS - PT-PT)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Voice ID de voz PT-PT — crie/clone uma voz PT-PT no dashboard ElevenLabs
ELEVENLABS_VOICE_ID=your_ptpt_voice_id

# Outbound — chave para proteger o endpoint de disparo de chamadas
OUTBOUND_API_KEY=your_secret_outbound_key

# CRM (a implementar)
CRM_API_URL=https://your-crm.com/api
CRM_API_KEY=your_crm_api_key
